{
    "name": "pulsecolor",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "description": "PulseColor theme for PulseSync, built with Vite",
    "scripts": {
        "dev": "node ./scripts/dev-build.mjs",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "sync": "node ./scripts/sync-addon.mjs",
        "build:sync": "yarn build && yarn sync"
    },
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "@pulsesync/yamusic-types": "^0.0.1",
        "@types/node": "^25.5.2",
        "esbuild": "^0.28.0",
        "prettier": "^3.8.1",
        "typescript": "^6.0.2",
        "vite": "^8.0.8"
    }
}
